# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- App ---
APP_NAME=TrustRAG Finance
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://trustrag:trustrag@localhost:5432/trustrag

# --- Providers (start as 'stub' so the skeleton runs with no keys) ---
LLM_PROVIDER=stub
EMBEDDING_PROVIDER=stub
RERANKER_PROVIDER=stub

# --- API keys (only needed once you switch providers off 'stub') ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Models ---
SYNTHESIS_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-opus-4-8
CLASSIFY_MODEL=claude-haiku-4-5-20251001

# --- Retrieval ---
RETRIEVAL_TOP_N=50
RETRIEVAL_TOP_K=8
RRF_K=60
